<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>dropwheel</AssemblyName>
    <RootNamespace>Dropwheel</RootNamespace>
    <Product>Dropwheel</Product>
    <!-- Release workflow overrides this from the tag (v1.2.3 → 1.2.3) -->
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\dropwheel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/taskbar icon (pack URI) and a loose copy for the tray, which loads it at the exact DPI size -->
    <Resource Include="Assets\dropwheel.ico" />
    <None Include="Assets\dropwheel.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Conversions, compression, archives, documents, templates: everything that isn't WPF or Windows-only -->
    <ProjectReference Include="..\Dropwheel.Core\Dropwheel.Core.csproj" />
  </ItemGroup>

</Project>
